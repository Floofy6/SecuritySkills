{
  "manifest_version": 3,
  "name": "Scoped Extension",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://app.example.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.example.com/projects/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": false
    }
  ]
}
